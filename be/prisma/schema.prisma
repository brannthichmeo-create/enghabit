// Enghabit — MySQL schema
//
// Quy ước (xem CLAUDE.md > Quy chuẩn kết nối database):
// - model PascalCase số ít, @@map sang tên bảng snake_case số nhiều
// - cột @map sang snake_case
// - mọi DateTime lưu UTC; riêng ActivityLog có thêm localDate (DATE) theo timezone user

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enum — phải khớp với shared/src/constants/enums.ts
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

/// Trạng thái tài khoản. LOCKED thì không đăng nhập được nhưng dữ liệu học vẫn giữ
/// nguyên — khoá là biện pháp có thể đảo ngược, khác hẳn với xoá.
enum UserStatus {
  ACTIVE
  LOCKED
}

enum GoalType {
  VOCAB_PER_DAY
  MINUTES_PER_DAY
  LESSONS_PER_WEEK
  STREAK_TARGET
}

enum GoalPeriod {
  DAILY
  WEEKLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum ActivityType {
  VOCAB_LEARNED
  FLASHCARD_REVIEWED
  QUIZ_COMPLETED
  HABIT_CHECKIN
}

enum VocabLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Loại thông báo trong ứng dụng. Thêm loại mới phải thêm cả ở shared/constants/enums.ts.
enum NotificationType {
  /// Nhắc học hằng ngày theo giờ user đặt
  DAILY_REMINDER
  /// Sắp hết ngày mà chưa học, chuỗi đang có nguy cơ đứt
  STREAK_AT_RISK
  /// Có thẻ flashcard tới hạn ôn
  REVIEW_DUE
  /// Còn từ sai chưa luyện lại
  MISTAKES_PENDING
  /// Đạt mục tiêu đã đặt
  GOAL_ACHIEVED
  /// Quản trị viên gửi tới người dùng
  ANNOUNCEMENT
  /// Quản trị viên gửi cảnh báo vi phạm — gửi cho MỌI thành viên của nhóm
  GROUP_WARNING
  /// Nhóm bị chặn hoặc được mở chặn — gửi cho MỌI thành viên
  GROUP_BLOCKED
  GROUP_UNBLOCKED
  /// Có người xin vào nhóm — gửi cho MỌI trưởng nhóm của nhóm đó
  GROUP_JOIN_REQUEST
  /// Yêu cầu vào nhóm được duyệt
  GROUP_JOIN_APPROVED
  /// Yêu cầu vào nhóm bị từ chối
  GROUP_JOIN_REJECTED
  /// Có yêu cầu cấp lại mật khẩu mới chờ duyệt — gửi cho MỌI quản trị viên
  PASSWORD_RESET_REQUEST
  /// Có báo cáo vi phạm mới về một bộ thẻ — gửi cho MỌI quản trị viên
  STUDY_SET_REPORTED
  /// Bộ thẻ bị chặn / được mở chặn — gửi cho chủ bộ thẻ
  STUDY_SET_BLOCKED
  STUDY_SET_UNBLOCKED
  /// Báo cáo của mình đã được xử lý — gửi cho người báo cáo
  STUDY_SET_REPORT_RESOLVED
  /// Được ai đó đề cập bằng @ trong bài đăng hoặc bình luận của nhóm
  MENTIONED
  /// Trưởng nhóm chia sẻ một bộ thẻ vào nhóm — gửi cho MỌI thành viên
  GROUP_STUDY_SET_SHARED
}

/// Ai thấy một bộ thẻ. PRIVATE thì người khác mở liên kết cũng nhận 404.
enum StudySetVisibility {
  PUBLIC
  PRIVATE
}

/// RESOLVED = đã chặn bộ thẻ; DISMISSED = xem xong, không vi phạm.
enum StudySetReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

/// Cách làm một thẻ. Chỉ có hai dạng — xem docs/ke-hoach-hoc-on-flashcard.md.
enum StudyMode {
  FLASHCARD
  MULTIPLE_CHOICE
}

/// Ai tìm thấy nhóm: công khai hiện trong ô tìm kiếm, riêng tư chỉ vào được bằng mã 8 số.
enum GroupVisibility {
  PUBLIC
  PRIVATE
}

/// Một nhóm có thể có NHIỀU trưởng nhóm, giống quản trị viên của nhóm Messenger.
enum GroupMemberRole {
  LEADER
  MEMBER
}

enum GroupJoinStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PasswordResetStatus {
  /// Đã gửi, quản trị viên chưa thao tác
  PENDING
  /// Đã duyệt — người dùng được phép đặt mật khẩu mới
  APPROVED
  /// Đã từ chối, kèm lý do
  REJECTED
}

enum DevicePlatform {
  web
  ios
  android
}

/// Lý do một dòng trong sổ cái xu. Thêm loại mới phải thêm cả ở shared/constants/enums.ts.
enum CoinReason {
  /// Điểm danh hằng ngày
  DAILY_CHECKIN
  /// Nhận thưởng một nhiệm vụ ngày
  MISSION_CLAIM
  /// Mua vật phẩm giữ chuỗi (amount âm)
  STREAK_FREEZE_PURCHASE
}

// ---------------------------------------------------------------------------
// Người dùng & xác thực
// ---------------------------------------------------------------------------

model User {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(100)
  email String @unique @db.VarChar(190) // 190 để vừa giới hạn index utf8mb4

  /// Tên tài khoản đăng nhập, KHÁC `name` (tên hiển thị, được phép trùng).
  /// Đăng nhập chấp nhận cả email lẫn tên này nên cả hai đều phải unique.
  username String @unique @db.VarChar(50)

  passwordHash String @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  /// Lần đăng nhập thành công gần nhất. Dẫn xuất từ LoginEvent, lưu sẵn để danh sách
  /// người dùng của trang quản trị không phải join bảng nhật ký cho từng dòng.
  lastLoginAt DateTime? @map("last_login_at")

  /// Timezone IANA, vd "Asia/Ho_Chi_Minh". Dùng để tính localDate của ActivityLog.
  timezone String @default("Asia/Ho_Chi_Minh") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  goals               Goal[]
  habits              Habit[]
  habitCheckIns       HabitCheckIn[]
  vocabProgress       UserVocabProgress[]
  activityLogs        ActivityLog[]
  streak              UserStreak?
  notificationSetting NotificationSetting?
  avatar              UserAvatar?
  reminders           Reminder[]
  devices             UserDevice[]
  refreshTokens       RefreshToken[]
  loginEvents         LoginEvent[]
  notifications       Notification[]
  coinTransactions    CoinTransaction[]
  streakFreezes       StreakFreeze[]
  createdTopics       Topic[]              @relation("TopicCreatedBy")
  ownedTopics         Topic[]              @relation("TopicOwner")
  blockedTopics       Topic[]              @relation("TopicBlockedBy")
  cardReviews         CardReview[]
  studySetReports     StudySetReport[]     @relation("StudySetReporter")
  resolvedStudySetReports StudySetReport[] @relation("StudySetReportResolver")
  createdGroups       Group[]              @relation("GroupCreatedBy")
  blockedGroups       Group[]              @relation("GroupBlockedBy")
  groupMemberships    GroupMember[]
  groupJoinRequests   GroupJoinRequest[]   @relation("JoinRequestUser")
  groupDecisions      GroupJoinRequest[]   @relation("JoinRequestDecidedBy")
  sharedGroupStudySets GroupStudySet[]     @relation("GroupStudySetSharedBy")
  posts               Post[]
  postComments        PostComment[]
  postLikes           PostLike[]

  /// Yêu cầu cấp lại mật khẩu do CHÍNH người này gửi
  passwordResetRequests PasswordResetRequest[] @relation("ResetRequester")

  /// Yêu cầu mà người này (quản trị viên) đã duyệt hoặc từ chối
  reviewedResetRequests PasswordResetRequest[] @relation("ResetReviewer")

  /// Các tính năng mà người này (quản trị viên) bật/tắt gần nhất
  featureFlagChanges FeatureFlag[] @relation("FeatureFlagUpdatedBy")

  @@map("users")
}

/// Ảnh đại diện, lưu thẳng trong DB.
///
/// Bảng RIÊNG chứ không phải cột trên `users`: dữ liệu ảnh nặng hơn hẳn phần còn lại
/// của một dòng user, để chung thì mọi truy vấn `findMany` không chọn cột (danh sách
/// người dùng của trang quản trị, bảng xếp hạng...) sẽ kéo theo cả đống byte không dùng.
///
/// Lưu trong DB thay vì ghi ra thư mục trên máy chủ vì nền tảng deploy free tier có ổ
/// đĩa tạm — mỗi lần deploy lại là mất sạch ảnh người dùng đã tải lên.
model UserAvatar {
  userId Int @id @map("user_id")

  /// Ảnh đã thu nhỏ ở phía client (xem shared/avatar). MEDIUMBLOB đủ cho ngưỡng 200KB.
  data Bytes @db.MediumBlob

  /// image/jpeg | image/png | image/webp — cần để dựng lại data URL khi trả về.
  mimeType String @map("mime_type") @db.VarChar(30)

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

/// Nhật ký đăng nhập — nguồn dữ liệu cho phần "lượt truy cập" của trang quản trị.
///
/// Ghi cả lần thất bại (userId = null khi email không tồn tại) để quản trị viên nhìn
/// ra được dấu hiệu dò mật khẩu, chứ không chỉ thấy các lần vào thành công.
model LoginEvent {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  email     String   @db.VarChar(190)
  success   Boolean
  /// Lý do thất bại: NO_ACCOUNT | WRONG_PASSWORD | LOCKED. Null khi thành công.
  reason    String?  @db.VarChar(32)
  ipAddress String?  @map("ip_address") @db.VarChar(45) // 45 = đủ cho IPv6
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  /// Xoá người dùng thì giữ lại dòng nhật ký (userId = null) — số liệu truy cập lịch sử
  /// không được biến mất chỉ vì một tài khoản bị xoá.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("login_events")
}

/// Refresh token được lưu dạng hash để nếu DB lộ thì token cũng không dùng lại được.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Yêu cầu cấp lại mật khẩu, do quản trị viên duyệt tay.
///
/// Bảng này là NGUỒN SỰ THẬT DUY NHẤT cho cả hai tab của màn "Quản lý yêu cầu":
/// tab Yêu cầu đọc các dòng PENDING, tab Nhật ký đọc các dòng đã xử lý sắp theo
/// `reviewedAt`. Không tách bảng nhật ký riêng — mọi thứ cần ghi lại (ai duyệt,
/// lúc nào, lý do từ chối) đều đã nằm sẵn ở đây, thêm bảng thứ hai chỉ tạo ra
/// chỗ để hai nguồn lệch nhau.
model PasswordResetRequest {
  id     Int                 @id @default(autoincrement())
  userId Int                 @map("user_id")
  status PasswordResetStatus @default(PENDING)

  /// Bằng `userId` khi đang chờ duyệt, NULL sau khi đã xử lý.
  ///
  /// Đây là cách chặn "một người có hai yêu cầu chờ cùng lúc" bằng RÀNG BUỘC DB
  /// thay vì đọc-rồi-ghi: hai request bấm cùng lúc đều đọc thấy "chưa có yêu cầu"
  /// và sẽ cùng tạo. MySQL cho phép nhiều NULL trong unique index nên lịch sử
  /// nhiều yêu cầu đã xử lý của cùng một người vẫn lưu được bình thường.
  /// Cùng thủ pháp với `StreakFreeze.usedOnDate`.
  pendingUserId Int? @unique @map("pending_user_id")

  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")

  /// Chỉ có giá trị khi status = REJECTED. Người dùng được xem lý do này.
  rejectReason String? @map("reject_reason") @db.VarChar(500)

  /// Thời điểm người dùng đã dùng lượt duyệt này để đặt mật khẩu mới.
  /// Một lần duyệt chỉ đổi được mật khẩu MỘT lần.
  usedAt DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user       User  @relation("ResetRequester", fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull chứ không Cascade: xoá tài khoản quản trị viên không được phép làm
  /// bốc hơi nhật ký phê duyệt — chỉ mất thông tin "ai làm", không mất sự kiện.
  reviewedBy User? @relation("ResetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, createdAt])
  @@index([reviewedAt])
  @@map("password_reset_requests")
}

// ---------------------------------------------------------------------------
// Mục tiêu & thói quen
// ---------------------------------------------------------------------------

model Goal {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  type        GoalType
  targetValue Int        @map("target_value")
  period      GoalPeriod
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime?  @map("end_date") @db.Date
  status      GoalStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("goals")
}

model Habit {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  name      String         @db.VarChar(120)
  frequency HabitFrequency

  /// Chỉ dùng khi frequency = CUSTOM. Mảng thứ trong tuần 1-7 (ISO), lưu dạng JSON.
  customDays Json? @map("custom_days")

  /// Giờ nhắc "HH:mm" theo timezone user. Null = không nhắc riêng cho thói quen này.
  reminderTime String? @map("reminder_time") @db.VarChar(5)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns HabitCheckIn[]

  @@index([userId, isActive])
  @@map("habits")
}

model HabitCheckIn {
  id      Int @id @default(autoincrement())
  habitId Int @map("habit_id")
  userId  Int @map("user_id")

  /// Ngày check-in theo timezone user. Unique cùng habitId để mỗi ngày chỉ check-in một lần.
  localDate DateTime @map("local_date") @db.Date

  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, localDate])
  @@index([userId, localDate])
  @@map("habit_check_ins")
}

// ---------------------------------------------------------------------------
// Nội dung học: chủ đề, từ vựng, tiến độ SRS
// ---------------------------------------------------------------------------

/// Một bộ thẻ. Tên bảng giữ là `topics` vì bộ của quản trị viên chính là các chủ đề cũ.
///
/// `ownerId` null là bộ "Hệ thống" do quản trị viên soạn ở /admin/content. Có giá trị là
/// bộ người học tự tạo. `createdById` giữ nguyên nghĩa cũ (ai bấm tạo) và KHÔNG dùng để
/// hiển thị tác giả.
model Topic {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(120)
  description String?    @db.VarChar(1000)
  level       VocabLevel
  createdById Int?       @map("created_by_id")

  /// Chủ bộ thẻ. Xoá tài khoản thì bộ thẻ xoá theo; khoá tài khoản thì bộ chỉ bị ẩn.
  ownerId    Int?               @map("owner_id")
  visibility StudySetVisibility @default(PUBLIC)

  /// Quản trị viên chặn vì vi phạm. Chặn không xoá dữ liệu — mở chặn là trở lại như cũ.
  blockedAt     DateTime? @map("blocked_at")
  /// Lý do chặn — HIỆN CHO CHỦ BỘ THẺ đọc, nên viết cho người dùng cuối.
  blockedReason String?   @map("blocked_reason") @db.VarChar(500)
  blockedById   Int?      @map("blocked_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy    User?            @relation("TopicCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  owner        User?            @relation("TopicOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  blockedBy    User?            @relation("TopicBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)
  vocabularies Vocabulary[]
  reports      StudySetReport[]
  groupShares  GroupStudySet[]

  @@index([level])
  @@index([ownerId])
  @@index([visibility, blockedAt])
  @@map("topics")
}

model Vocabulary {
  id       Int     @id @default(autoincrement())
  topicId  Int     @map("topic_id")
  word     String  @db.VarChar(100)
  meaning  String  @db.VarChar(500)
  phonetic String? @db.VarChar(100)
  example  String? @db.VarChar(500)
  audioUrl String? @map("audio_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topic       Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress    UserVocabProgress[]
  cardReviews CardReview[]

  @@index([topicId])
  @@map("vocabularies")
}

/// Tiến độ ôn tập SM-2 của một user với một từ. Xem shared/src/srs/sm2.ts.
model UserVocabProgress {
  id           Int @id @default(autoincrement())
  userId       Int @map("user_id")
  vocabularyId Int @map("vocabulary_id")

  repetitions    Int       @default(0)
  intervalDays   Int       @default(0) @map("interval_days")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  nextReviewDate DateTime  @map("next_review_date") @db.Date
  lastReviewedAt DateTime? @map("last_reviewed_at")

  /// Bộ đếm cho nhóm "Yếu" — xem shared/src/study/study.ts `isWeakCard`.
  /// Số lần quên (quality dưới 3).
  lapses       Int @default(0)
  correctCount Int @default(0) @map("correct_count")
  wrongCount   Int @default(0) @map("wrong_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId, nextReviewDate])
  @@map("user_vocab_progress")
}

/// Lịch sử từng lần làm một thẻ (Học hoặc Ôn tập). Cram Mode không ghi vào đây.
///
/// CHỈ phục vụ lịch sử và độ chính xác. Streak, XP, thống kê ngày vẫn tính từ
/// ActivityLog — đọc bảng này để đếm hoạt động là tạo nguồn số liệu thứ hai.
model CardReview {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  vocabularyId Int       @map("vocabulary_id")
  mode         StudyMode
  isCorrect    Boolean   @map("is_correct")
  /// ReviewQuality 0-5 đã đưa vào SM-2.
  quality      Int
  responseMs   Int?      @map("response_ms")

  intervalBefore Int @map("interval_before")
  intervalAfter  Int @map("interval_after")

  /// Băm của mã câu hỏi. Unique theo người để bấm hai lần / mạng gửi lại không tính hai lần.
  attemptKey String  @map("attempt_key") @db.Char(64)
  /// Có giá trị khi làm trong phiên Học — dùng để ghi một dòng "hoàn thành phiên".
  sessionKey String? @map("session_key") @db.Char(36)

  reviewedAt DateTime @default(now()) @map("reviewed_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, attemptKey])
  @@index([userId, reviewedAt])
  @@index([userId, sessionKey])
  @@index([vocabularyId])
  @@map("card_reviews")
}

/// Báo cáo vi phạm một bộ thẻ công khai.
model StudySetReport {
  id         Int                  @id @default(autoincrement())
  topicId    Int                  @map("topic_id")
  reporterId Int                  @map("reporter_id")
  reason     String               @db.VarChar(500)
  status     StudySetReportStatus @default(PENDING)

  /// `<topicId>:<reporterId>` khi còn chờ xử lý, null khi đã xử lý. Unique chặn một người
  /// gửi hai báo cáo chờ cho cùng một bộ; MySQL cho nhiều NULL nên báo cáo cũ đã xử lý
  /// không cản người đó báo cáo lại về sau.
  pendingKey String? @unique @map("pending_key") @db.VarChar(40)

  resolvedById Int?      @map("resolved_by_id")
  resolvedAt   DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  topic      Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reporter   User  @relation("StudySetReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("StudySetReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([topicId])
  @@index([reporterId])
  @@map("study_set_reports")
}

// ---------------------------------------------------------------------------
// Hoạt động & streak
// ---------------------------------------------------------------------------

/// NGUỒN SỰ THẬT DUY NHẤT cho streak và mọi thống kê.
/// Mọi hoạt động học đều phải ghi vào đây (xem CLAUDE.md).
model ActivityLog {
  id     Int          @id @default(autoincrement())
  userId Int          @map("user_id")
  type   ActivityType

  /// Id của bản ghi liên quan (vocabularyId, topicId, habitId...). Không ràng buộc FK vì đa hình.
  refId Int? @map("ref_id")

  /// Giá trị định lượng của hoạt động: số từ đã học, số phút, điểm kiểm tra...
  value Int @default(1)

  /// Thời điểm UTC.
  occurredAt DateTime @default(now()) @map("occurred_at")

  /// Ngày theo timezone user tại thời điểm ghi. MỌI thống kê/streak group theo cột này.
  localDate DateTime @map("local_date") @db.Date

  /// Khoá chống ghi trùng, tuỳ chọn. Hiện dùng cho dòng "hoàn thành phiên Học"
  /// (`SESSION:<sessionKey>`) để bấm kết thúc hai lần không thành hai phiên.
  /// Null thì không ràng buộc — MySQL cho nhiều NULL trong unique index.
  dedupeKey String? @map("dedupe_key") @db.VarChar(80)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, localDate])
  @@index([userId, type, localDate])
  @@map("activity_logs")
}

/// Cache dẫn xuất từ ActivityLog — KHÔNG phải nguồn sự thật.
/// Sai thì chạy `pnpm db:recompute-streak`, không sửa tay (xem CLAUDE.md).
model UserStreak {
  userId         Int       @id @map("user_id")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastActiveDate DateTime? @map("last_active_date") @db.Date
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

// ---------------------------------------------------------------------------
// Lộ trình học
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Thông báo
// ---------------------------------------------------------------------------

/// Cài đặt nhắc nhở CHUNG của một người dùng.
///
/// Giờ nhắc nằm ở bảng `reminders` (nhiều mốc mỗi người), không nằm ở đây. Công tắc
/// `isEnabled` là công tắc tổng: tắt thì im lặng hết, không cần xoá từng mốc.
model NotificationSetting {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique @map("user_id")
  isEnabled Boolean @default(true) @map("is_enabled")

  /// Cảnh báo khi sắp hết ngày mà chuỗi đang có nguy cơ đứt.
  remindStreakAtRisk Boolean @default(true) @map("remind_streak_at_risk")

  /// Nhắc khi có thẻ flashcard tới hạn ôn.
  remindReviewDue Boolean @default(true) @map("remind_review_due")

  /// Ngày (local) đã gửi nhắc nhở gần nhất — chặn gửi trùng khi cron chạy lại.
  lastSentDate DateTime? @map("last_sent_date") @db.Date

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// Một mốc nhắc nhở trong ngày. Mỗi người đặt được nhiều mốc (sáng, tối...).
///
/// `@@unique([userId, timeOfDay])` chặn đặt hai mốc trùng giờ — hai mốc cùng 20:00 sẽ
/// bắn hai thông báo giống hệt nhau trong cùng một phút, người dùng chỉ thấy đó là lỗi.
/// Số mốc tối đa mỗi người kiểm ở service (MAX_REMINDERS_PER_USER trong shared).
model Reminder {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// Tên gợi nhớ do người dùng đặt, vd "Trước khi đi làm". Null thì hiển thị theo giờ.
  label String? @db.VarChar(60)

  /// Giờ nhắc "HH:mm" theo timezone user.
  timeOfDay String @map("time_of_day") @db.VarChar(5)

  /// Mảng thứ trong tuần 1-7 (ISO), lưu JSON. Riêng cho từng mốc.
  daysOfWeek Json @map("days_of_week")

  /// Tắt riêng một mốc mà không xoá nó — dùng khi chỉ muốn nghỉ nhắc tạm thời.
  isEnabled Boolean @default(true) @map("is_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, timeOfDay])
  @@index([userId])
  @@map("reminders")
}

/// Thông báo hiện trong ứng dụng.
///
/// Lưu lại thay vì chỉ bắn push, vì push có thể bị chặn hoặc bỏ lỡ — người dùng mở
/// app sau đó vẫn phải thấy được việc cần làm. Push chỉ là kênh báo thêm.
model Notification {
  id     Int              @id @default(autoincrement())
  userId Int              @map("user_id")
  type   NotificationType
  title  String           @db.VarChar(150)
  body   String           @db.VarChar(500)

  /// Đường dẫn trong app để bấm vào là tới thẳng việc cần làm, vd "/flashcards".
  link String? @db.VarChar(120)

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  /// Khoá chống trùng, dạng "<TYPE>:<local_date>" hoặc "ANNOUNCEMENT:<id>".
  /// Cron chạy lại trong ngày sẽ không tạo thêm bản ghi giống hệt.
  dedupeKey String @map("dedupe_key") @db.VarChar(120)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Thiết bị nhận push. playerId do OneSignal SDK cấp phía client.
model UserDevice {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  playerId  String         @unique @map("player_id") @db.VarChar(200)
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

// ---------------------------------------------------------------------------
// Phần thưởng động viên (điểm danh, nhiệm vụ ngày, vật phẩm giữ chuỗi)
// ---------------------------------------------------------------------------

/// Sổ cái xu — NGUỒN SỰ THẬT của số dư.
///
/// Không có bảng lưu số dư: số dư = SUM(amount) tính lúc đọc. Ở quy mô vài trăm user,
/// thêm cột số dư chỉ tạo thêm một chỗ có thể lệch với sổ cái mà không nhanh hơn đáng kể
/// (cùng lý do với thống kê tính thẳng từ ActivityLog — xem CLAUDE.md).
///
/// Xu KHÔNG phải XP: XP suy ra từ ActivityLog nên không thể tặng thêm. Nhờ tách hẳn
/// hai thứ, thưởng xu bao nhiêu cũng không làm sai cấp độ hay số liệu học tập.
model CoinTransaction {
  id     Int        @id @default(autoincrement())
  userId Int        @map("user_id")
  /// Dương là nhận, âm là tiêu.
  amount Int
  reason CoinReason

  /// Khoá chống trùng: "DAILY_CHECKIN:<local_date>", "MISSION:<id>:<local_date>".
  /// Ràng buộc unique bên dưới là thứ duy nhất đảm bảo bấm hai lần không nhận hai lần —
  /// kiểm tra bằng câu lệnh đọc trước khi ghi vẫn có thể lọt khi hai request về cùng lúc.
  dedupeKey String @map("dedupe_key") @db.VarChar(120)

  /// Ngày local của user lúc phát sinh — mọi thống kê xu group theo cột này.
  localDate DateTime @map("local_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, localDate])
  @@map("coin_transactions")
}

// ---------------------------------------------------------------------------
// Cộng đồng — diễn đàn hỏi đáp dùng chung cho cả người học và quản trị viên
// ---------------------------------------------------------------------------

/// Một bài đăng trên diễn đàn.
///
/// Bài đăng KHÔNG phải hoạt động học nên không sinh `ActivityLog` (cùng nguyên tắc
/// với module rewards): viết bài không giúp người ta nhớ từ vựng, ghi vào đó thì
/// đăng vài dòng là đủ giữ chuỗi và mọi thống kê học tập sẽ nói dối.
model Post {
  id       Int    @id @default(autoincrement())
  authorId Int    @map("author_id")
  title    String @db.VarChar(200)

  /// Nội dung dạng văn bản thuần. KHÔNG lưu HTML: nội dung do người dùng viết mà
  /// render lại thành HTML cho người khác xem là đường thẳng tới XSS.
  body String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Null = bài ở diễn đàn chung. Có giá trị = bài nội bộ của nhóm, chỉ thành viên đọc được.
  groupId Int? @map("group_id")

  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group       Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  comments    PostComment[]
  likes       PostLike[]
  attachments PostAttachment[]

  @@index([createdAt])
  @@index([authorId])
  @@index([groupId, createdAt])
  @@map("posts")
}

/// Bình luận trong một bài đăng. Cố ý phẳng, không lồng nhau — luồng trả lời nhiều
/// tầng làm giao diện phức tạp hẳn mà một diễn đàn hỏi đáp quy mô này không cần.
model PostComment {
  id       Int    @id @default(autoincrement())
  postId   Int    @map("post_id")
  authorId Int    @map("author_id")
  body     String @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("post_comments")
}

/// Một lượt thả tim. Số tim = đếm số dòng, không có cột đếm sẵn — cùng lý do với
/// số dư xu tính bằng SUM: thêm cột đếm là thêm một chỗ có thể lệch với sự thật.
///
/// `@@unique([postId, userId])` là thứ DUY NHẤT chặn thả tim hai lần cho cùng một
/// bài khi hai request về cùng lúc; kiểm tra đọc-rồi-ghi vẫn lọt.
model PostLike {
  id     Int @id @default(autoincrement())
  postId Int @map("post_id")
  userId Int @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

/// Tệp đính kèm của một bài đăng, lưu thẳng trong DB.
///
/// Lưu trong DB thay vì ghi ra ổ đĩa vì nền tảng deploy free tier có ổ đĩa tạm —
/// mỗi lần deploy lại là mất sạch tệp người dùng đã tải lên (cùng lý do với UserAvatar).
///
/// CẢNH BÁO khi truy vấn: cột `data` nặng hơn hẳn phần còn lại của một dòng. Mọi chỗ
/// liệt kê bài viết PHẢI `select` riêng các cột mô tả, tuyệt đối không `include:
/// { attachments: true }` — một trang danh sách sẽ kéo về hàng chục MB byte không dùng.
/// Chỉ endpoint tải tệp mới được đọc cột này.
model PostAttachment {
  id     Int @id @default(autoincrement())
  postId Int @map("post_id")

  data Bytes @db.MediumBlob

  /// Chỉ nhận các giá trị trong danh sách trắng ở shared/attachment. Khi trả tệp về
  /// phải dùng đúng giá trị đã lưu này, không bao giờ dùng Content-Type do client gửi.
  mimeType String @map("mime_type") @db.VarChar(100)

  /// Tên tệp gốc, chỉ để hiển thị và đặt tên khi tải về.
  fileName String @map("file_name") @db.VarChar(255)

  /// Kích thước sau khi giải mã, lưu sẵn để danh sách hiện được cỡ tệp mà không đọc `data`.
  sizeBytes Int @map("size_bytes")

  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_attachments")
}

// ---------------------------------------------------------------------------
// Nhóm lớp
// ---------------------------------------------------------------------------

/// Nhóm trao đổi nội bộ do người học tự lập.
model Group {
  id Int @id @default(autoincrement())

  /// Mã 8 chữ số, duy nhất toàn hệ thống — cách duy nhất tìm ra một nhóm riêng tư.
  /// Dùng Char(8) chứ không phải Int: mã bắt đầu bằng số 0 vẫn phải giữ nguyên 8 ký tự.
  code String @unique @db.Char(8)

  name        String  @db.VarChar(120)
  description String? @db.VarChar(500)

  visibility GroupVisibility @default(PUBLIC)

  /// Bật thì người xin vào phải chờ duyệt; tắt thì vào thẳng.
  requireApproval Boolean @default(true) @map("require_approval")

  /// Người lập nhóm. Cho phép null để xoá tài khoản không kéo theo cả nhóm — nhóm vẫn
  /// còn trưởng nhóm khác điều hành (xem quy tắc "luôn còn ít nhất một trưởng nhóm").
  createdById Int? @map("created_by_id")

  /// Thời điểm quản trị viên chặn nhóm. Null nghĩa là nhóm đang hoạt động bình thường.
  ///
  /// Chặn KHÔNG xoá dữ liệu: bài đăng và thành viên còn nguyên, chỉ đóng băng nhóm lại.
  /// Nhờ vậy mở chặn là nhóm trở lại y như cũ, và lý do chặn vẫn tra lại được.
  blockedAt DateTime? @map("blocked_at")

  /// Lý do chặn — HIỆN CHO THÀNH VIÊN NHÓM đọc khi họ mở nhóm, nên viết cho người
  /// dùng cuối chứ không phải ghi chú nội bộ.
  blockedReason String? @map("blocked_reason") @db.VarChar(500)

  blockedById Int? @map("blocked_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy    User?              @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  blockedBy    User?              @relation("GroupBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)
  members      GroupMember[]
  joinRequests GroupJoinRequest[]
  posts        Post[]
  studySets    GroupStudySet[]

  @@index([visibility, createdAt])
  @@index([blockedAt])
  @@map("groups")
}

model GroupMember {
  id      Int             @id @default(autoincrement())
  groupId Int             @map("group_id")
  userId  Int             @map("user_id")
  role    GroupMemberRole @default(MEMBER)

  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Chặn một người vào nhóm hai lần. Đây là thứ DUY NHẤT chặn được khi hai request
  /// duyệt cùng một yêu cầu về đúng lúc — kiểm tra đọc-rồi-ghi vẫn lọt.
  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// Một lượt xin vào nhóm.
///
/// Mỗi cặp (nhóm, người) chỉ có MỘT dòng: bị từ chối rồi xin lại thì cập nhật chính
/// dòng đó về PENDING, không tạo dòng mới. Nhờ vậy hộp yêu cầu của trưởng nhóm không
/// bị một người xin đi xin lại làm ngập.
model GroupJoinRequest {
  id      Int             @id @default(autoincrement())
  groupId Int             @map("group_id")
  userId  Int             @map("user_id")
  status  GroupJoinStatus @default(PENDING)

  /// Lời nhắn gửi trưởng nhóm, vd "Em là sinh viên lớp K65".
  message String? @db.VarChar(300)

  decidedById Int?      @map("decided_by_id")
  decidedAt   DateTime? @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User  @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("JoinRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId])
  @@map("group_join_requests")
}

/// Một bộ thẻ được trưởng nhóm chia sẻ vào nhóm.
///
/// Bảng này CHỈ mở thêm quyền đọc, không sao chép gì cả: bộ thẻ vẫn là một dòng duy
/// nhất trong `topics`, do chủ của nó sửa ở Thư viện. Nhân bản bộ thẻ khi chia sẻ sẽ
/// làm bản trong nhóm đứng yên trong khi bản gốc được sửa tiếp, và mỗi người học một
/// nội dung khác nhau.
///
/// Gỡ chia sẻ hoặc xoá bộ thẻ chỉ xoá dòng ở đây; tiến độ SRS của thành viên giữ
/// nguyên để chia sẻ lại là học tiếp được (cùng lý do với việc chuyển bộ về riêng tư).
model GroupStudySet {
  id      Int @id @default(autoincrement())
  groupId Int @map("group_id")
  topicId Int @map("topic_id")

  /// Trưởng nhóm đã chia sẻ. Null khi tài khoản đó bị xoá — bộ vẫn ở lại nhóm vì
  /// những người đang học dở không nên mất quyền vì một người rời đi.
  sharedById Int? @map("shared_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic    Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sharedBy User? @relation("GroupStudySetSharedBy", fields: [sharedById], references: [id], onDelete: SetNull)

  /// Chặn chia sẻ hai lần cùng một bộ vào cùng một nhóm. Đây là thứ DUY NHẤT chặn
  /// được khi hai trưởng nhóm bấm cùng lúc — kiểm tra đọc-rồi-ghi vẫn lọt.
  @@unique([groupId, topicId])
  @@index([groupId, createdAt])
  @@index([topicId])
  @@map("group_study_sets")
}

/// Một vật phẩm giữ chuỗi. Mỗi dòng là một cái đã mua.
///
/// `usedOnDate` null nghĩa là còn trong kho; có giá trị nghĩa là đã dùng để bù cho
/// đúng ngày đó. Ràng buộc unique (user, usedOnDate) chặn việc bù hai vật phẩm cho
/// cùng một ngày — MySQL cho phép nhiều dòng NULL trong unique index, nên các vật
/// phẩm chưa dùng vẫn nằm chung được.
///
/// Bảng này cùng với ActivityLog là toàn bộ dữ liệu để dựng lại UserStreak
/// (xem shared/streak/computeStreak) — quy tắc "không sửa tay user_streaks" giữ nguyên.
model StreakFreeze {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  purchasedAt DateTime  @default(now()) @map("purchased_at")
  usedOnDate  DateTime? @map("used_on_date") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usedOnDate])
  @@index([userId])
  @@map("streak_freezes")
}

/// Trạng thái bật/tắt của MỘT tính năng người học.
///
/// Bảng này CHỈ giữ trạng thái. Danh sách "hệ thống có những tính năng nào" nằm ở
/// shared/src/constants/features.ts, trong mã nguồn — vì thêm tính năng mới là thêm
/// code chứ không phải thêm một dòng dữ liệu.
///
/// THIẾU DÒNG NGHĨA LÀ BẬT. Nhờ vậy deploy bản có tính năng mới là nó chạy ngay,
/// không cần seed hay migration dữ liệu; và dòng mang `key` lạ còn sót từ bản cũ chỉ
/// bị bỏ qua khi đọc chứ không gây lỗi.
///
/// Tắt tính năng KHÔNG đụng tới dữ liệu người học: ActivityLog, Goal, Habit,
/// UserVocabProgress giữ nguyên, bật lại là thấy lại đúng chỗ đang dở. Cùng tinh thần
/// với khoá tài khoản và chặn nhóm — đảo ngược được, khác hẳn với xoá.
model FeatureFlag {
  id Int @id @default(autoincrement())

  /// Khớp FeatureKey ở shared/constants/features.ts
  key String @unique @db.VarChar(50)

  isEnabled Boolean @default(true) @map("is_enabled")

  /// Quản trị viên đổi lần gần nhất. SetNull vì xoá một tài khoản quản trị không được
  /// phép kéo theo trạng thái tính năng của cả hệ thống.
  updatedById Int?  @map("updated_by_id")
  updatedBy   User? @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedById])
  @@map("feature_flags")
}
