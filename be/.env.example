# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit file .env.
# Xem CLAUDE.md > Quy chuẩn kết nối database.

# connection_limit là BẮT BUỘC — MySQL free tier giới hạn số kết nối đồng thời.
# DB hosted (Aiven) đã luôn mã hoá sẵn, KHÔNG thêm sslaccept=strict nếu không kèm
# sslcert=ca.pem — thiếu chứng chỉ thì lỗi "unknown Cert Authority".
#
# Chọn MỘT trong hai, theo README.md > Bước 4:
#
# A) Nhiều máy dùng chung dữ liệu — database enghabit_dev trên Aiven.
#    connection_limit=3 vì trần 76 kết nối chia cho nhiều máy cộng với Render.
#    KHÔNG trỏ vào defaultdb — đó là database production của Render.
#   mysql://avnadmin:MK@host:12691/enghabit_dev?connection_limit=3&connect_timeout=15
#
# B) Một máy, dữ liệu riêng — MySQL local qua XAMPP hoặc Docker (dòng mặc định dưới đây).
DATABASE_URL="mysql://root:password@localhost:3306/enghabit?connection_limit=5"

NODE_ENV=development
PORT=4000

# CORS — origin của web app
CORS_ORIGIN=http://localhost:5173

# Chuỗi ngẫu nhiên đủ dài, mỗi môi trường một giá trị khác nhau
JWT_ACCESS_SECRET=thay-bang-chuoi-ngau-nhien-that-dai
JWT_REFRESH_SECRET=thay-bang-chuoi-ngau-nhien-khac-dai
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OneSignal — chỉ là kênh gửi, lịch gửi do be/src/jobs quyết định
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Bật/tắt cron nhắc nhở (tắt khi chạy test hoặc chạy nhiều instance)
ENABLE_REMINDER_JOB=true
